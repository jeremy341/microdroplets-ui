}

QWidget#cameraPage QLabel#cameraFieldLabel {
    color: #26332E;
    font-size: 15px;
    font-weight: 400;
}

QWidget#cameraPage QGroupBox#cameraCard {
    background-color: #FFFFFF;
    color: #18231F;
    border: 1px solid #D7DEE1;
    border-radius: 8px;
    margin-top: 0px;
    padding-top: 38px;
    font-size: 18px;
    font-weight: 700;
}

QWidget#cameraPage QGroupBox#cameraCard::title {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    left: 20px;
    top: 16px;
    padding: 0;
