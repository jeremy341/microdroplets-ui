    color: #2F785E;
    border-color: #85C4AA;
}

QScrollArea#driverScroll,
QScrollArea#driverScroll > QWidget > QWidget,
QWidget#driverContainer {
    background-color: transparent;
    border: none;
}

QGroupBox#driverCard {
    background-color: #FFFFFF;
    border: 1px solid #D8E1DC;
    border-radius: 9px;
    padding-top: 24px;
}

/* V20 camera reference layout ------------------------------------------- */
QWidget#cameraPage {
    background-color: #FBFCFB;
}

QWidget#cameraPage QLabel#pageTitle {
    color: #18231F;
    font-family: "Segoe UI";
