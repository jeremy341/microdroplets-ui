    border-color: #BFD9CD;
    background-color: #FFFFFF;
}

QWidget#cameraPage QPushButton#cameraSecondaryButton,
QWidget#cameraPage QPushButton#cameraPrimaryButton,
QWidget#cameraPage QPushButton#cameraActionButton {
    min-height: 46px;
    max-height: 46px;
    border-radius: 8px;
}

QWidget#cameraPage QPushButton#cameraPrimaryButton {
    color: #087C5C;
    border-color: #2C9B75;
    background-color: #FFFFFF;
}

QWidget#cameraPage QPushButton#cameraPrimaryButton:hover,
QWidget#cameraPage QPushButton#cameraSecondaryButton:hover,
QWidget#cameraPage QPushButton#cameraActionButton:hover {
    background-color: #F1FAF6;
    border-color: #168B67;
}

QWidget#cameraPage QLabel#cameraPreview {
    border-radius: 8px;
    border: 1px solid #253032;
}

QWidget#cameraPage QSlider#parameterSlider {
    min-height: 22px;
}

QWidget#cameraPage QSlider#parameterSlider::groove:horizontal {
    height: 5px;
    border-radius: 3px;
    background-color: #DEE8E4;
}

QWidget#cameraPage QSlider#parameterSlider::sub-page:horizontal {
    border-radius: 3px;
    background-color: #2A9C76;
}

QWidget#cameraPage QSlider#parameterSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border: 1px solid #C7D7D1;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QWidget#cameraPage QLabel#cameraDeviceValue[state="disabled"] {
    color: #AEBAB5;
}

QWidget#cameraPage QLabel#cameraHint,
QWidget#cameraPage QLabel#cameraFocusHint,
QWidget#cameraPage QLabel#cameraValue {
    color: #70817B;
}

QWidget#cameraPage QLabel#cameraCaptureIcon {
    background-color: #EEF5F1;
    border-radius: 8px;
}

QWidget#cameraPage QComboBox#cameraCombo[toolbar="true"],
QWidget#cameraPage QPushButton#cameraStatus {
    min-height: 50px;
    max-height: 50px;
}

/* Camera slider treatment: a quiet neutral rail, green active travel, and
   a low-contrast locked state when Auto Exposure owns the value. */
QWidget#cameraPage QSlider#parameterSlider::groove:horizontal {
    height: 5px;
    border-radius: 3px;
    background-color: #DCE4E1;
}

QWidget#cameraPage QSlider#parameterSlider::sub-page:horizontal {
    border-radius: 3px;
    background-color: #2A9C76;
}

QWidget#cameraPage QSlider#parameterSlider::add-page:horizontal {
    border-radius: 3px;
    background-color: #DCE4E1;
}

QWidget#cameraPage QSlider#parameterSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border: 1px solid #C5D2CD;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QWidget#cameraPage QSlider#parameterSlider:hover::handle:horizontal,
QWidget#cameraPage QSlider#parameterSlider:focus::handle:horizontal {
    border-color: #2A9C76;
}

QWidget#cameraPage QSlider#parameterSlider:disabled::groove:horizontal,
QWidget#cameraPage QSlider#parameterSlider:disabled::sub-page:horizontal,
QWidget#cameraPage QSlider#parameterSlider:disabled::add-page:horizontal {
