}

QWidget#cameraPage QSlider#parameterSlider {
    min-height: 20px;
}

QWidget#cameraPage QSlider#parameterSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: #DCE4E1;
}

QWidget#cameraPage QSlider#parameterSlider::sub-page:horizontal {
    border-radius: 2px;
    background: #279F7B;
}

QWidget#cameraPage QSlider#parameterSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border: 1px solid #C7D2D1;
    border-radius: 9px;
    background: #FFFFFF;
}

QWidget#cameraPage QSlider#parameterSlider:disabled::groove:horizontal {
    background: #E8ECEB;
}

QWidget#cameraPage QSlider#parameterSlider:disabled::sub-page:horizontal {
    background: #E8ECEB;
}

/* Auto exposure owns the device value and makes the manual slider inactive. */
QWidget#cameraPage QLabel#cameraDeviceValue[state="disabled"] {
    color: #B0BBB7;
}

QWidget#cameraPage QSlider#parameterSlider:disabled {
    opacity: 0.72;
}

/* Camera page refinement: compact instrument surfaces with a consistent
   field rhythm. Scoped so the rest of the application keeps its baseline. */
QWidget#cameraPage {
    background-color: #F8FAF9;
}

QWidget#cameraPage QGroupBox#cameraCard {
    background-color: #FFFFFF;
    border: 1px solid #CFDCD8;
    border-radius: 9px;
    padding-top: 40px;
}

QWidget#cameraPage QGroupBox#cameraCard::title {
    left: 20px;
    top: 14px;
    color: #172A34;
    font-size: 18px;
    font-weight: 700;
}

QWidget#cameraPage QLabel#cameraFieldLabel {
    color: #213841;
    font-size: 14px;
    font-weight: 500;
}

QWidget#cameraPage QComboBox#cameraCombo {
    min-height: 44px;
    max-height: 44px;
    padding: 0 32px 0 13px;
    border-radius: 8px;
